<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SPRView.Net.ViewModel"
    xmlns:media="using:Avalonia.Media"
    x:Class="SPRView.Net.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="SPRView.Net"
    Width="720" Height="560"
    MinWidth="600" MinHeight="440"
    Icon="/Assets/icon.ico"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="32"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
    DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{CompiledBinding CreateFile}" />
    <KeyBinding Gesture="Ctrl+O" Command="{CompiledBinding OpenFile}" />
    <KeyBinding Gesture="Ctrl+S" Command="{CompiledBinding SaveFrame}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{CompiledBinding SaveGIF}" />
    <KeyBinding Gesture="Ctrl+E" Command="{CompiledBinding Export}" />
    <KeyBinding Gesture="Ctrl+P" Command="{CompiledBinding SavePalette}" />
    <KeyBinding Gesture="Space" Command="{CompiledBinding ToggleAnimationTimer}" />
    <KeyBinding Gesture="Left" Command="{CompiledBinding PreviousFrame}" />
    <KeyBinding Gesture="Right" Command="{CompiledBinding NextFrame}" />
    <!-- Digit keys are named D0..D9 in the Key enum; "Ctrl+0" would not parse. -->
    <KeyBinding Gesture="Ctrl+D0" Command="{CompiledBinding ZoomReset}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{CompiledBinding ZoomIn}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{CompiledBinding ZoomIn}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{CompiledBinding ZoomOut}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{CompiledBinding ZoomOut}" />
  </Window.KeyBindings>

  <!-- Window background: one flat surface, WinUI 3 "solid base" material. -->
  <Panel Name="RootPanel" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid RowDefinitions="32,38,*,42">

      <!-- ============================ Caption ============================ -->
      <Grid Grid.Row="0"
            Name="CaptionBar"
            Background="{DynamicResource WindowCaptionBackgroundBrush}"
            PointerPressed="OnCaptionPressed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal"
                    Margin="10,0,0,0" Spacing="6" VerticalAlignment="Center">
          <Image Source="/Assets/app-icon.png" Width="16" Height="16"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="{CompiledBinding CaptionPrimary}"
                     FontSize="12.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource WindowCaptionForegroundBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{CompiledBinding CaptionSecondary}"
                     IsVisible="{CompiledBinding HasFile}"
                     FontSize="12.5"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Classes="caption" Theme="{StaticResource CaptionButton}"
                  Click="OnMinimizeClick" IsEnabled="{CompiledBinding $parent[Window].CanResize}">
            <Path Classes="glyph" Data="{StaticResource Glyph_Minimize}" />
          </Button>
          <Button Classes="caption" Theme="{StaticResource CaptionButton}"
                  Click="OnMaximizeClick" IsEnabled="{CompiledBinding $parent[Window].CanResize}">
            <Path Name="MaximizeGlyph" Classes="glyph" Data="{StaticResource Glyph_Maximize}" />
          </Button>
          <Button Classes="caption captionClose" Theme="{StaticResource CaptionCloseButton}"
                  Click="OnCloseClick">
            <Path Classes="glyph" Data="{StaticResource Glyph_Close}" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- ========================== Command bar ========================== -->
      <Border Grid.Row="1"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
        <Grid Margin="6,0" ColumnDefinitions="*,Auto">
          <!-- File actions -->
          <ScrollViewer Grid.Column="0"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
              <Button Classes="command" Theme="{StaticResource CommandButton}" Click="OnNewClick"
                      ToolTip.Tip="{CompiledBinding Lang.TaskBar_File_Create}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource Icon_NewFile}" />
                  <TextBlock Text="{CompiledBinding Lang.TaskBar_File_Create}" VerticalAlignment="Center"
                         IsVisible="{CompiledBinding ShowCommandLabels}" />
                </StackPanel>
              </Button>

              <Button Classes="command" Theme="{StaticResource CommandButton}" Click="OnOpenClick"
                      ToolTip.Tip="{CompiledBinding Lang.TaskBar_File_Open}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource Icon_Open}" />
                  <TextBlock Text="{CompiledBinding Lang.Action_Open}" VerticalAlignment="Center"
                         IsVisible="{CompiledBinding ShowCommandLabels}" />
                </StackPanel>
              </Button>

              <Border Classes="dividerV" />

              <Button Classes="command" Theme="{StaticResource CommandButton}" Click="OnSaveFrameClick"
                      IsEnabled="{CompiledBinding HasSprite}"
                      ToolTip.Tip="{CompiledBinding Lang.TaskBar_File_SaveFrame}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource Icon_SaveImage}" />
                  <TextBlock Text="{CompiledBinding Lang.Command_SaveImage}" VerticalAlignment="Center"
                         IsVisible="{CompiledBinding ShowCommandLabels}" />
                </StackPanel>
              </Button>

              <Button Classes="command" Theme="{StaticResource CommandButton}" Click="OnSaveGifClick"
                      IsEnabled="{CompiledBinding HasSprite}"
                      ToolTip.Tip="{CompiledBinding Lang.TaskBar_File_SaveGIF}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource Icon_SaveAnimate}" />
                  <TextBlock Text="{CompiledBinding Lang.Command_SaveAnim}" VerticalAlignment="Center"
                         IsVisible="{CompiledBinding ShowCommandLabels}" />
                </StackPanel>
              </Button>

              <Button Classes="command" Theme="{StaticResource CommandButton}" Click="OnExportClick"
                      IsEnabled="{CompiledBinding HasSprite}"
                      ToolTip.Tip="{CompiledBinding Lang.TaskBar_File_Export}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource Icon_Export}" />
                  <TextBlock Text="{CompiledBinding Lang.Command_Export}" VerticalAlignment="Center"
                         IsVisible="{CompiledBinding ShowCommandLabels}" />
                </StackPanel>
              </Button>

              <Button Classes="command" Theme="{StaticResource CommandButton}" Click="OnSavePaletteClick"
                      IsEnabled="{CompiledBinding HasSprite}"
                      ToolTip.Tip="{CompiledBinding Lang.TaskBar_File_SavePalette}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource Icon_SavePalette}" />
                  <TextBlock Text="{CompiledBinding Lang.Command_SavePalette}" VerticalAlignment="Center"
                         IsVisible="{CompiledBinding ShowCommandLabels}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>

          <!-- View options: panel toggles as a small segmented control. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                      VerticalAlignment="Center">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="2">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton Name="SidePanelToggle"
                              Classes="toolbar" Theme="{StaticResource ToolbarToggleButton}"
                              IsChecked="{CompiledBinding ShowSidePanel}"
                              IsEnabled="{CompiledBinding HasSprite}"
                              ToolTip.Tip="{CompiledBinding Lang.Dock_SidePanel}">
                  <Path Classes="icon" Data="{StaticResource Icon_SidePanel}" />
                </ToggleButton>
                <ToggleButton Classes="toolbar" Theme="{StaticResource ToolbarToggleButton}"
                              IsChecked="{CompiledBinding ShowInfoPanel}"
                              IsEnabled="{CompiledBinding SectionTogglesEnabled}"
                              ToolTip.Tip="{CompiledBinding Lang.TaskBar_View_Information}">
                  <Path Classes="icon" Data="{StaticResource Icon_Details}" />
                </ToggleButton>
                <ToggleButton Classes="toolbar" Theme="{StaticResource ToolbarToggleButton}"
                              IsChecked="{CompiledBinding ShowPalettePanel}"
                              IsEnabled="{CompiledBinding SectionTogglesEnabled}"
                              ToolTip.Tip="{CompiledBinding Lang.TaskBar_View_Pallet}">
                  <Path Classes="icon" Data="{StaticResource Icon_Palette}" />
                </ToggleButton>
                <ToggleButton Name="TransparencyToggle"
                              Classes="toolbar" Theme="{StaticResource ToolbarToggleButton}"
                              IsChecked="{CompiledBinding ApplyTransparency}"
                              IsEnabled="{CompiledBinding HasSprite}"
                              ToolTip.Tip="{CompiledBinding Lang.Dock_Transparency}">
                  <Path Classes="icon" Data="{StaticResource Icon_Transparency}" />
                </ToggleButton>
              </StackPanel>
            </Border>

            <Border Classes="dividerV" />

            <Button Classes="command" Theme="{StaticResource CommandButton}"
                    ToolTip.Tip="{CompiledBinding Lang.TaskBar_View_Language}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Path Classes="icon" Data="{StaticResource Icon_Globe}" />
                <Path Classes="icon" Width="12" Height="12" Data="{StaticResource Icon_ChevronDown}" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="简体中文" Command="{CompiledBinding ChangeLang}" CommandParameter="zh" />
                  <MenuItem Header="English" Command="{CompiledBinding ChangeLang}" CommandParameter="en" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Classes="command" Theme="{StaticResource CommandButton}" Click="OnAboutClick"
                    ToolTip.Tip="{CompiledBinding Lang.TaskBar_Help_About}">
              <Path Classes="icon" Data="{StaticResource Icon_About}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============================= Body ============================= -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">

        <!-- Viewport: checkerboard so sprite transparency is readable. -->
        <Border Grid.Column="0"
                Name="Viewport"
                Margin="6"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                ClipToBounds="True">
          <Panel>
            <!-- Checkerboard: only meaningful behind a sprite, so it stays out
                 of the empty state where it would just add noise. -->
            <Border IsVisible="{CompiledBinding HasSprite}"
                    Background="{StaticResource ViewportCheckerBrush}" />

            <ScrollViewer Name="ViewportScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0">
              <Panel MinWidth="{Binding $parent[ScrollViewer].Bounds.Width}"
                     MinHeight="{Binding $parent[ScrollViewer].Bounds.Height}">
                <Image Source="{CompiledBinding SPR}"
                       IsVisible="{CompiledBinding HasSprite}"
                       Width="{CompiledBinding SprViewerSize.Width}"
                       Height="{CompiledBinding SprViewerSize.Height}"
                       Stretch="Fill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="None" />
              </Panel>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel IsVisible="{CompiledBinding !HasSprite}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="6" MaxWidth="360">
              <Viewbox Width="46" Height="46" Margin="0,0,0,4">
                <Path Classes="icon" Width="20" Height="20"
                      Data="{StaticResource Icon_SaveImage}"
                      Stroke="{DynamicResource TextFillColorTertiaryBrush}" />
              </Viewbox>
              <TextBlock Classes="bodyStrong" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center"
                         Text="{CompiledBinding Lang.Empty_Title}" />
              <TextBlock Classes="caption" TextAlignment="Center" TextWrapping="Wrap"
                         Text="{CompiledBinding Lang.Empty_Subtitle}" />
              <Button Content="{CompiledBinding Lang.Action_Open}"
                      Classes="accent" Margin="0,14,0,0" MinWidth="140"
                      HorizontalAlignment="Center"
                      Click="OnOpenClick" />
            </StackPanel>

            <!-- Drop hint -->
            <Border Name="DropHint"
                    IsVisible="False"
                    Margin="6"
                    CornerRadius="6"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    Background="#1A0078D4">
              <TextBlock Classes="bodyStrong"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="{CompiledBinding Lang.Empty_Drop}" />
            </Border>
          </Panel>
        </Border>

        <!-- Side panel -->
        <Border Grid.Column="1"
                IsVisible="{CompiledBinding CanShowSideBar}"
                Width="248"
                Margin="0,6,6,6"
                CornerRadius="8"
                ClipToBounds="True"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2,0,6">
            <StackPanel>

              <!-- Sprite information; the header collapses the rows. -->
              <StackPanel IsVisible="{CompiledBinding ShowInfoPanel}">
                <Button Name="InfoSectionHeader"
                        Theme="{StaticResource SectionHeaderButton}"
                        Margin="6,2,6,0"
                        Click="OnToggleInfoSection"
                        ToolTip.Tip="{CompiledBinding Lang.Dock_CollapseSection}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <Path Grid.Column="0" Classes="icon" Width="16" Height="16"
                          Data="{StaticResource Icon_Details}" />
                    <TextBlock Grid.Column="1" Classes="bodyStrong"
                               Text="{CompiledBinding Lang.TaskBar_View_Information}"
                               VerticalAlignment="Center" />
                    <Panel Grid.Column="2">
                      <Path Classes="iconChevron" Data="{StaticResource Icon_ChevronDown12}"
                            IsVisible="{CompiledBinding IsInfoExpanded}" />
                      <Path Classes="iconChevron" Data="{StaticResource Icon_ChevronRight12}"
                            IsVisible="{CompiledBinding !IsInfoExpanded}" />
                    </Panel>
                  </Grid>
                </Button>

                <StackPanel Margin="12,2,12,6"
                            IsVisible="{CompiledBinding IsInfoExpanded}">
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_Frames}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding Frame}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_Width}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding Width}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_Height}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding Height}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_Type}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding Type}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_Format}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding Format}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_Sync}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding Sync}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_BoundRadius}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding BoundRadius}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_BeamLength}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding BeamLength}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_OriginX}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding OriginX}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Classes="fieldLabel" Text="{CompiledBinding Lang.SpriteInfo_OriginY}" />
                    <TextBlock Grid.Column="1" Classes="fieldValue" Text="{CompiledBinding OriginY}" />
                  </Grid>
                </StackPanel>
              </StackPanel>

              <Border Classes="dividerH" Margin="12,0"
                      IsVisible="{CompiledBinding ShowInfoDivider}" />

              <!-- Palette; the header collapses the grid. -->
              <StackPanel IsVisible="{CompiledBinding ShowPalettePanel}">
                <Button Name="PaletteSectionHeader"
                        Theme="{StaticResource SectionHeaderButton}"
                        Margin="6,2,6,0"
                        Click="OnTogglePaletteSection"
                        ToolTip.Tip="{CompiledBinding Lang.Dock_CollapseSection}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                    <Path Grid.Column="0" Classes="icon" Width="16" Height="16"
                          Data="{StaticResource Icon_Palette}" />
                    <TextBlock Grid.Column="1" Classes="bodyStrong"
                               Text="{CompiledBinding Lang.TaskBar_View_Pallet}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center"
                               Text="{CompiledBinding PaletteCountLabel}" />
                    <Panel Grid.Column="3">
                      <Path Classes="iconChevron" Data="{StaticResource Icon_ChevronDown12}"
                            IsVisible="{CompiledBinding IsPaletteExpanded}" />
                      <Path Classes="iconChevron" Data="{StaticResource Icon_ChevronRight12}"
                            IsVisible="{CompiledBinding !IsPaletteExpanded}" />
                    </Panel>
                  </Grid>
                </Button>

                <ItemsControl ItemsSource="{CompiledBinding PaletteSwatches}"
                              IsVisible="{CompiledBinding IsPaletteExpanded}"
                              Margin="12,2,12,4">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="16" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="media:SolidColorBrush">
                      <Border Height="14" Margin="1"
                              CornerRadius="2"
                              Background="{Binding}"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- ========================== Transport bar ========================== -->
      <Border Grid.Row="3"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
        <Grid Margin="8,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">

          <!-- Playback -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="transport" Theme="{StaticResource PlayButton}"
                    Click="OnTogglePlayClick"
                    IsEnabled="{CompiledBinding HasSprite}"
                    ToolTip.Tip="{CompiledBinding Lang.Dock_PlayPause}">
              <Panel>
                <Path Classes="icon iconFilled" Data="{StaticResource Icon_Play}"
                      IsVisible="{CompiledBinding !IsPlaying}" />
                <Path Classes="icon iconFilled" Data="{StaticResource Icon_Stop}"
                      IsVisible="{CompiledBinding IsPlaying}" />
              </Panel>
            </Button>
            <ToggleButton Classes="toolbar" Theme="{StaticResource ToolbarToggleButton}"
                          IsChecked="{CompiledBinding IsLoopPlay}"
                          IsEnabled="{CompiledBinding HasSprite}"
                          ToolTip.Tip="{CompiledBinding Lang.Dock_Loop}">
              <Path Classes="icon" Data="{StaticResource Icon_Loop}" />
            </ToggleButton>
          </StackPanel>

          <Border Grid.Column="1" Classes="dividerV" />

          <!-- Frame scrubber -->
          <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Slider Grid.Column="0"
                    Name="FrameSlider"
                    Theme="{StaticResource ThinSlider}"
                    Minimum="0"
                    Maximum="{CompiledBinding MaxFrame}"
                    Value="{CompiledBinding FramePosition}"
                    IsEnabled="{CompiledBinding HasSprite}"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="caption"
                       MinWidth="50" TextAlignment="Right"
                       VerticalAlignment="Center"
                       Text="{CompiledBinding FrameLabel}" />
          </Grid>

          <!-- Zoom -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="subtle" Theme="{StaticResource SubtleButton}"
                    Click="OnZoomOutClick" IsEnabled="{CompiledBinding HasSprite}"
                    ToolTip.Tip="{CompiledBinding Lang.Dock_ZoomOut}">
              <Path Classes="icon" Data="{StaticResource Icon_ZoomOut}" />
            </Button>
            <Button Classes="subtle" Theme="{StaticResource SubtleButton}"
                    Click="OnZoomResetClick" IsEnabled="{CompiledBinding HasSprite}"
                    Width="56" ToolTip.Tip="{CompiledBinding Lang.Dock_ZoomReset}">
              <TextBlock Classes="fieldValue" FontSize="12.5" Text="{CompiledBinding ZoomLabel}" />
            </Button>
            <Button Classes="subtle" Theme="{StaticResource SubtleButton}"
                    Click="OnZoomInClick" IsEnabled="{CompiledBinding HasSprite}"
                    ToolTip.Tip="{CompiledBinding Lang.Dock_ZoomIn}">
              <Path Classes="icon" Data="{StaticResource Icon_ZoomIn}" />
            </Button>
            <Button Classes="subtle" Theme="{StaticResource SubtleButton}"
                    Click="OnZoomFitClick" IsEnabled="{CompiledBinding HasSprite}"
                    ToolTip.Tip="{CompiledBinding Lang.Dock_Fit}">
              <Path Classes="icon" Data="{StaticResource Icon_Fit}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Resize grips are added by WindowChrome.AddResizeGrips in the code behind. -->
  </Panel>
</Window>
