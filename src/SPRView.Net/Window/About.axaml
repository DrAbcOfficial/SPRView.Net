<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SPRView.Net.ViewModel"
    x:Class="SPRView.Net.AboutWindow"
    x:DataType="vm:AboutViewModel"
    Title="SPRView.Net"
    Width="400"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    Icon="/Assets/icon.ico"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="32"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d" d:DesignWidth="420">

  <Panel Name="RootPanel" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid RowDefinitions="32,Auto">

      <Grid Grid.Row="0"
            Name="CaptionBar"
            Background="{DynamicResource WindowCaptionBackgroundBrush}"
            PointerPressed="OnCaptionPressed">
        <TextBlock Text="{CompiledBinding Lang.About_Title}" FontSize="12" Margin="12,0,0,0"
                   Foreground="{DynamicResource WindowCaptionForegroundBrush}"
                   VerticalAlignment="Center" />
        <Button Classes="caption captionClose" Theme="{StaticResource CaptionCloseButton}"
                HorizontalAlignment="Right" Click="OnCloseClick">
          <Path Classes="glyph" Data="{StaticResource Glyph_Close}" />
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="20,16,20,18" Spacing="12">

        <StackPanel Orientation="Horizontal" Spacing="12">
          <Image Source="/Assets/app-icon.png" Width="48" Height="48"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 VerticalAlignment="Top" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="subtitle" Text="SPRView.Net" />
            <TextBlock Classes="caption" Text="{CompiledBinding Lang.About_Tagline}" />
            <TextBlock Classes="caption" Text="{CompiledBinding VersionLabel}" />
            <TextBlock Classes="caption" Text="{CompiledBinding BuildTimeLabel}" />
            <TextBlock Classes="caption" Text="Dr.Abc" />
          </StackPanel>
        </StackPanel>

        <Border Classes="dividerH" />

        <StackPanel Spacing="2">
          <TextBlock Classes="caption" Text="{CompiledBinding Lang.About_BuiltWith}" Margin="0,0,0,4" />
          <HyperlinkButton NavigateUri="https://avaloniaui.net/" Padding="0" MinHeight="0">
            <TextBlock Classes="body" FontSize="13" Text="Avalonia UI" />
          </HyperlinkButton>
          <HyperlinkButton NavigateUri="https://github.com/SixLabors/ImageSharp" Padding="0" MinHeight="0">
            <TextBlock Classes="body" FontSize="13" Text="SixLabors.ImageSharp" />
          </HyperlinkButton>
        </StackPanel>

        <Border Classes="dividerH" />

        <Button Theme="{StaticResource CommandButton}" HorizontalAlignment="Left"
                HorizontalContentAlignment="Left" Click="OnSourceCodeClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Width="16" Height="16" Data="{StaticResource Icon_ExternalLink}" />
            <TextBlock Text="{CompiledBinding Lang.About_SourceCode}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Panel>
</Window>
