<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="SPRView.Net.MessageBoxWindow"
    CanResize="False"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Width="420"
    MaxHeight="560"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="36"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d" d:DesignWidth="420">

  <Panel Name="RootPanel" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid RowDefinitions="36,Auto,Auto">

      <Grid Grid.Row="0"
            Name="CaptionBar"
            Background="{DynamicResource WindowCaptionBackgroundBrush}"
            PointerPressed="OnCaptionPressed">
        <TextBlock Name="TitleText" Text="SPRView.Net" FontSize="12" Margin="12,0,0,0"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource WindowCaptionForegroundBrush}"
                   VerticalAlignment="Center" />
        <Button Name="CloseButton" Classes="caption captionClose"
                Theme="{StaticResource CaptionCloseButton}"
                HorizontalAlignment="Right" Click="Button_Click">
          <Path Classes="glyph" Data="{StaticResource Glyph_Close}" />
        </Button>
      </Grid>

      <!-- Content: scrolls when an exception trace is long. -->
      <ScrollViewer Grid.Row="1" Margin="24,20,24,0"
                    MaxHeight="380"
                    VerticalScrollBarVisibility="Auto">
        <TextBlock Name="Message"
                   Classes="body"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Text=""/>
      </ScrollViewer>

      <!-- Action row, right aligned like a ContentDialog. -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Right" Margin="24,20,24,20">
        <Button Name="Cancel" Content="Cancel" MinWidth="96" Click="Button_Click" />
        <Button Name="OK" Content="OK" MinWidth="96" Classes="accent"
                IsDefault="True" Click="Button_Click" />
      </StackPanel>
    </Grid>
  </Panel>
</Window>
