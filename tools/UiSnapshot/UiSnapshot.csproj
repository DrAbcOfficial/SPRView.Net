<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Development tool: renders the windows off screen with the headless Skia
    backend and writes PNGs, so the layout can be reviewed on any machine
    without a desktop session. Not part of the shipped solution.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SPRView.Net\SPRView.Net.csproj" />
  </ItemGroup>
</Project>
