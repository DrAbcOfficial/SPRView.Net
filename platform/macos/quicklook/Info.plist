    <key>CFBundleDisplayName</key>
    <string>SPRView QuickLook</string>
    <key>CFBundleIdentifier</key>
    <string>net.sprview.SPRView.QuickLook</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
